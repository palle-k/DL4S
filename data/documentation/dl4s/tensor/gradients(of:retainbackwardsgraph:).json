{"abstract":[{"text":"Performs backpropagation and returns the gradients for the given tensors.","type":"text"}],"identifier":{"url":"doc:\/\/DL4S\/documentation\/DL4S\/Tensor\/gradients(of:retainBackwardsGraph:)","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/DL4S\/documentation\/DL4S","doc:\/\/DL4S\/documentation\/DL4S\/Tensor"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gradients","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"tensors","kind":"internalParam"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:4DL4S6TensorV","text":"Tensor","kind":"typeIdentifier","identifier":"doc:\/\/DL4S\/documentation\/DL4S\/Tensor"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">], ","kind":"text"},{"text":"retainBackwardsGraph","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"retainGraph","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" = false) -> [","kind":"text"},{"preciseIdentifier":"s:4DL4S6TensorV","text":"Tensor","kind":"typeIdentifier","identifier":"doc:\/\/DL4S\/documentation\/DL4S\/Tensor"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">]","kind":"text"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Tensors to differentiate for"}],"type":"paragraph"}],"name":"tensors"},{"content":[{"inlineContent":[{"type":"text","text":"Whether to store the graph for the backwards pass. If enabled, higher order gradients can be computed."}],"type":"paragraph"}],"name":"retainGraph"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tensors for which it is desired to compute gradients must have "},{"code":"requiresGradient","type":"codeVoice"},{"type":"text","text":" set to "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If the result is not differentiable with respect to an input tensor, a tensor of zeros will be returned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"syntax":null,"type":"codeListing","code":["let a = Tensor<Float, CPU>([1,2,3,4,5], requiresGradient: true)","let result = a * a * a \/\/ [1, 8, 27, 64, 125]","","let grads = result.gradients(of: [a])","let ∇a = grads[0] \/\/ [3, 12, 27, 48, 75]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To detach a tensor from the compute graph, use "},{"code":"tensor.detached()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If it is desired to compute second, third, etc. derivatives, the "},{"code":"retainBackwardsGraph","type":"codeVoice"},{"type":"text","text":" flag must be set to true."},{"type":"text","text":" "},{"type":"text","text":"This will record the compute graph for the backpropagation operation. A second derivative can then be computed as the gradient of a gradient."},{"type":"text","text":" "},{"type":"text","text":"If the flag is not set, the compute graph of the backwards operation will not be captured and the result is not differentiable to any variable."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dl4s\/tensor\/gradients(of:retainbackwardsgraph:)"]}],"metadata":{"role":"symbol","title":"gradients(of:retainBackwardsGraph:)","symbolKind":"method","modules":[{"name":"DL4S"}],"externalID":"s:4DL4S6TensorV9gradients2of20retainBackwardsGraphSayACyxq_GGAH_SbtF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gradients","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:4DL4S6TensorV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">], ","kind":"text"},{"text":"retainBackwardsGraph","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Tensor","preciseIdentifier":"s:4DL4S6TensorV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">]","kind":"text"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://DL4S/documentation/DL4S/Tensor":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tensor"}],"role":"symbol","title":"Tensor","kind":"symbol","type":"topic","url":"\/documentation\/dl4s\/tensor","navigatorTitle":[{"kind":"identifier","text":"Tensor"}],"abstract":[{"text":"A tensor is an n-dimensional array of numbers with a given shape.","type":"text"}],"identifier":"doc:\/\/DL4S\/documentation\/DL4S\/Tensor"},"doc://DL4S/documentation/DL4S/Tensor/gradients(of:retainBackwardsGraph:)":{"type":"topic","abstract":[{"text":"Performs backpropagation and returns the gradients for the given tensors.","type":"text"}],"url":"\/documentation\/dl4s\/tensor\/gradients(of:retainbackwardsgraph:)","identifier":"doc:\/\/DL4S\/documentation\/DL4S\/Tensor\/gradients(of:retainBackwardsGraph:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gradients","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:4DL4S6TensorV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">], ","kind":"text"},{"text":"retainBackwardsGraph","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> [","kind":"text"},{"text":"Tensor","kind":"typeIdentifier","preciseIdentifier":"s:4DL4S6TensorV"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Device","kind":"typeIdentifier"},{"text":">]","kind":"text"}],"title":"gradients(of:retainBackwardsGraph:)"},"doc://DL4S/documentation/DL4S":{"type":"topic","abstract":[{"text":"DL4S provides a high-level API for many accelerated operations common in neural networks and deep learning.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It furthermore has automatic differentiation builtin, which allows you to create and train neural networks without needing to manually"},{"type":"text","text":" "},{"type":"text","text":"implement backpropagation - without needing a special Swift toolchain."}],"url":"\/documentation\/dl4s","kind":"symbol","identifier":"doc:\/\/DL4S\/documentation\/DL4S","role":"collection","title":"DL4S"}}}